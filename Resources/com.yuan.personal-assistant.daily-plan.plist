<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.yuan.personal-assistant.daily-plan</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/PersonalAssistant</string>
	<key>ProgramArguments</key>
	<array>
		<string>Contents/MacOS/PersonalAssistant</string>
		<string>--daily-plan-worker</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>9</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
